{
  "imports": {
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.6.3",
    "@needle-di/core": "jsr:@needle-di/core@^1.2.1",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.12.0",
    "@types/pg": "npm:@types/pg@^8.23.1",
    "drizzle-kit": "npm:drizzle-kit@^0.31.10",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2",
    "pg": "npm:pg@^8.23.0",
    "hono": "npm:hono@^4.13.7",
    "zod": "npm:zod@^4.5.4"
  },
  "permissions": {
    "development": {
      "sys": true,
      "env": true,
      "run": true,
      "read": true,
      "write": true,
      "net": true
    },
    "database": {
      "env": true,
      "read": true,
      "write": true,
      "net": true,
      "run": true,
      "sys": true
    }
  },
  "tasks": {
    "dev": "deno run --permission-set=development --env --watch src/main.ts",
    "debug": "deno run --inspect-wait --permission-set=development --env --watch src/main.ts",
    "check": "deno check src/main.ts",
    "studio": "deno run --permission-set=database --node-modules-dir npm:drizzle-kit studio",
    "generate": "deno run --permission-set=database --node-modules-dir npm:drizzle-kit generate",
    "migrate": "deno run --permission-set=database --node-modules-dir --env src/tasks/migrate.ts",
    "setup": "deno run --permission-set=database --env src/tasks/seed-data.ts",
    "dns": "deno run --permission-set=development --env src/tasks/dns.ts",
    "udp": "deno run --permission-set=development --env src/tasks/udp-dump.ts"
  },
  "unstable": ["cron", "net"]
}
