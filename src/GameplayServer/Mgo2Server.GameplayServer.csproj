<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Mgo2Server.GameplayServer</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>Mgo2Server.GameplayServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Mgo2Server.Shared.csproj" />
    <ProjectReference Include="..\Infrastructure\Mgo2Server.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    The packet-replay console and the captured packet data it lists are deployed
    beside the executable: the data is regenerated by tools/export_acked_packets.py
    without a rebuild, and the page is read from disk rather than embedded.
  -->
  <ItemGroup>
    <!-- The Web SDK already includes .json files as content; this only asks for it to be copied out. -->
    <Content Update="PacketReplay/acked-packets.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="PacketReplay/index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
