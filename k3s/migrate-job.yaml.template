# The one-shot schema migration the deploy workflow runs before it updates any
# image.
#
# This file is a template, and its extension is deliberate. `kubectl apply -f
# k3s/` sweeps this directory recursively and would pick up a `.yaml` file here,
# which would start the job at whatever tag `latest` happened to hold — a second
# run, from possibly a different revision than the code being deployed, and one
# nothing waits on. The deploy step substitutes the tag below and pipes the
# result to kubectl itself.
#
# The bundle is the one the mgo2-postgres image carries. There is no database
# container in this deployment — the servers point at an external Postgres — so
# nothing applies migrations on startup the way docker/entrypoint-postgres.sh
# does, and this job is the only thing that may change the schema.
apiVersion: batch/v1
kind: Job
metadata:
  name: mgo2-migrate
  namespace: mgo2
spec:
  # A failed migration is a stop, not a retry. The whole point of migrating before
  # the deploy is to keep an image that disagrees with the schema from starting,
  # and a job that retries hides that until it eventually gives up.
  backoffLimit: 0
  # Backstop, so a hung migration releases the deployment instead of holding it
  # until the workflow's own wait expires.
  activeDeadlineSeconds: 600
  template:
    metadata:
      labels:
        app: mgo2-migrate
    spec:
      restartPolicy: Never
      containers:
      - name: migrate
        image: ghcr.io/miguelripoll23/mgo2-server/mgo2-postgres:__MGO2_IMAGE_TAG__
        imagePullPolicy: Always
        # The postgres image's entrypoint starts a server; this job wants only the
        # bundle it carries. `command` replaces ENTRYPOINT, and WORKDIR in that
        # image is where the bundle sits.
        command:
        - sh
        - -c
        - exec ./efbundle --connection "${DATABASE_CONNECTION_STRING:-$DATABASE_URL}"
        # The same secret the deployments take their whole environment from, so
        # the connection string is never copied into a workflow or an image.
        envFrom:
        - secretRef:
            name: mgo2-secrets
        env:
        # The bundle extracts itself before running, and the base image's HOME
        # belongs to root, which the container is not. Without this the
        # extraction fails before a single migration is read.
        - name: DOTNET_BUNDLE_EXTRACT_BASE_DIR
          value: /tmp
        resources: {}
        # The same posture the server deployments run under.
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          runAsNonRoot: true
          runAsUser: 1000
          seccompProfile:
            type: RuntimeDefault
        terminationMessagePath: /dev/termination-log
        terminationMessagePolicy: File
      dnsPolicy: ClusterFirst
      schedulerName: default-scheduler
      securityContext: {}
      terminationGracePeriodSeconds: 30
