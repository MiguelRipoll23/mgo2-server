# Every setting is a single upper-case environment variable, without sections
# and without double underscores. Copy this file to .env before starting the
# deployment; scripts/install-linux-macos.sh and scripts/install-windows.ps1 do
# that for you.
#
# This file holds the settings the whole deployment shares. The identity of each
# individual gameplay lobby is set per container in compose.yaml, so there is one
# environment file, not one per container.
#
# The containers share the host network, so no port is published and a client
# reaches every server through PUBLIC_IP, below. On Linux nothing else is needed;
# Docker Desktop for Windows and macOS only honours the host network once
# Settings -> Resources -> Network -> "Enable host networking" is turned on.

# ── Container images ────────────────────────────────────────────────────────
# Registry prefix the published images are pulled from, including the trailing
# slash. This is what the CI workflow publishes to; point it at a fork's own
# registry, or pass it to the install script as its first argument, to run a
# different build.
MGO2_IMAGE_PREFIX=ghcr.io/miguelripoll23/mgo2-server/
MGO2_IMAGE_TAG=latest

# ── Database ────────────────────────────────────────────────────────────────
# Connection string of the PostgreSQL server. Compose runs every container on
# the host network, so the postgres service is reached through the loopback
# address rather than by its service name. The gate, the account server, the
# gameplay lobbies and the gameplay servers all wait for its healthcheck before
# they start, so the schema is created exactly once however many containers come
# up at the same time.
DATABASE_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=mgo2;Username=postgres

# ── Identity ────────────────────────────────────────────────────────────────
# Private address of this machine on the network the game clients share, for
# example 192.168.1.50. It is what the name server answers the local domains
# with and what every lobby publishes, so a console or another computer on the
# network can reach the servers.
#
# The servers always listen on every interface, so a client running on this
# machine keeps working too: the name server answers it with 0.0.0.0, which
# routes to loopback. Leave this empty to announce 0.0.0.0 to everyone, which
# only a client on this machine can connect to.
PUBLIC_IP=

# ── Logging ─────────────────────────────────────────────────────────────────
# Minimum level the servers log at. The default is Debug so UDP/TCP packet
# hex dumps are visible; set it to Information, Warning or Error to quiet the
# console. The level can be changed at runtime by editing this file or by setting
# the environment variable while the servers are running.
# LOG_LEVEL=Debug

# Directory to write log files into. Set by the run scripts to .logs/ so each
# server gets a server.log with daily rotation. Leave unset to only log to the
# console.
# LOG_DIRECTORY=.logs

# ── Gameplay lobbies ────────────────────────────────────────────────────────
# Every lobby runs as its own container that publishes its own row, so no lobby
# has to be seeded beforehand. The identity and the attributes of a lobby
# (LOBBY_NAME, LOBBY_SUBTYPE, LOBBY_PORT, LOBBY_BEGINNER_ONLY,
# LOBBY_EXPANSION_ONLY, LOBBY_NO_HEADSHOT, LOBBY_REPLAYS_ONLY) are set on its
# own service block in compose.yaml, where LOBBY_SUBTYPE is the name of a game
# type of the lobby_game_types table: FREE BATTLE, AUTOMATCHING, TOURNAMENT,
# SURVIVAL, TRAINING or TOURNAMENT REGISTRATION. Change them there, not here, so
# that two lobbies cannot end up claiming the same name or port.

# ── Gameplay servers ─────────────────────────────────────────────────────────
# UDP port a GameplayServer container listens on, and the lobby it publishes
# its match in. One container per host.
GAMEPLAY_SERVER_PORT=5730
GAMEPLAY_SERVER_LOBBY_NAME=Free Battle

# Address the gameplay server announces to its peers. Defaults to PUBLIC_IP,
# and to loopback when no public address is configured.
# P2P_HOST=192.168.1.50

# Account and character the gameplay server logs in with. Leave the password
# unset to have a random one generated for each process, so the account cannot
# be logged into with a known default.
# GAMEPLAY_SERVER_ACCOUNT_NAME=server
# GAMEPLAY_SERVER_ACCOUNT_PASSWORD=
# GAMEPLAY_SERVER_CHARACTER_NAME=server

# ── HTTP API ────────────────────────────────────────────────────────────────
# Port the HTTP API listens on, and the upstream launcher its policy document
# and patch files are mirrored from.
HTTP_PORT=80
LAUNCHER_SERVER=http://mgo2pc.com

# Secret used to sign and validate the API's bearer tokens. Required.
JWT_SECRET=changeme

# ── Name server ─────────────────────────────────────────────────────────────
# Port the name server listens on, the upstream server it forwards to, and the
# domains it answers locally.
DNS_PORT=53
ALTERNATIVE_DNS_SERVER=8.8.8.8
ALTERNATIVE_DNS_PORT=53

# Comma-separated domains resolved to PUBLIC_IP instead of being forwarded.
# Only exact matches are overridden; subdomains must be listed explicitly.
LOCAL_RESOLVED_DOMAINS=mgo2pc.com,game.mgo2pc.com

# Address the name server answers a query from this machine with. The default,
# 0.0.0.0, routes to loopback, which is what a client running here has to connect
# to. Only change it when loopback is not what you want.
# LOCAL_RESOLVED_IP=0.0.0.0

# Address an IPv6 address record for a local domain is answered with, so a
# resolver asking for both records is not handed the domain's upstream IPv6.
# Left unset, it is derived from the IPv4 answers above: the wildcard :: when
# the wildcard is resolved, or their address in IPv6-mapped form otherwise.
# PUBLIC_IPV6=::
# LOCAL_RESOLVED_IPV6=::

# ── Lobby lifecycle ─────────────────────────────────────────────────────────
# Interval in minutes between two heartbeats and two lobby cache refreshes. A
# gameplay lobby, and a match owned by a gameplay server, is served only while it
# was written to within twice this interval, after which it is cleaned up.
LOBBIES_REFRESH_INTERVAL_MINUTES=5
