# Every setting is a single upper-case environment variable, without sections
# and without double underscores. Copy this file to .env before starting the
# deployment; scripts/install-linux-macos.sh and scripts/install-windows.ps1 do
# that for you.
#
# This file holds the settings the whole deployment shares. The identity of each
# individual gameplay lobby is set per container in compose.yaml, so there is one
# environment file, not one per container.

# ── Container images ────────────────────────────────────────────────────────
# Registry prefix the published images are pulled from, including the trailing
# slash. This is what the CI workflow publishes to; point it at a fork's own
# registry, or pass it to the install script as its first argument, to run a
# different build.
MGO2_IMAGE_PREFIX=ghcr.io/miguelripoll23/mgo2-server/
MGO2_IMAGE_TAG=latest

# ── Database ────────────────────────────────────────────────────────────────
# Connection string of the PostgreSQL server. Compose points this at its own
# postgres service, which applies schema migrations on startup before accepting
# connections. The gate, the account server, the gameplay lobbies and the
# gameplay servers all wait for its healthcheck before they start.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=mgo2;Username=postgres

# ── Identity ────────────────────────────────────────────────────────────────
# Private address of this machine on the network the game clients share, for
# example 192.168.1.50. The name server answers the local domains with it, the
# port-check responder answers the console on it, and every lobby and gameplay
# host publishes it in the database, so a console or another computer on the
# network can reach the servers through the published ports. The install scripts
# detect and write it. Servers always bind every interface (0.0.0.0).
ADVERTISED_ADDRESS=

# ── Logging ─────────────────────────────────────────────────────────────────
# Minimum level the servers log at: Debug, Information, Warning or Error. Every
# container writes its log to its standard output, so this is the level of
# 'docker compose logs' and of the log pane of the Docker dashboard. The install
# scripts ask for it and default to Warning, and the run scripts
# (run-linux-macos.sh, run-windows.ps1) set LOG_LEVEL=Debug so packet hex dumps
# are visible during development. Servers started without the setting log at
# Warning. Change the level here and run 'docker compose up --detach' again to
# recreate the containers with it.
LOG_LEVEL=Warning

# Directory to write log files into. Set by the run scripts to .logs/ so each
# server gets a log.txt with daily rotation. Leave unset to only log to the
# console.
# LOG_DIRECTORY=.logs

# ── Telemetry ───────────────────────────────────────────────────────────────
# Whether the servers export their metrics over OpenTelemetry. The install
# scripts ask for it and default to yes; the run scripts always turn it on. With
# it off, no OpenTelemetry integration is configured and the servers export
# nothing. The HTTP API publishes total_users, the number of accounts, when one
# is created; the lobby servers publish total_players, the players currently in
# the lobby, and total_matches, each time the value changes. The players and the
# matches carry a "lobby" attribute, so both can be filtered by lobby.
OTEL_ENABLED=true

# Port the OTLP/gRPC collector (Grafana Alloy) listens on. The run scripts use
# 4317, and the install scripts write the answer to their question here.
# Changing it is the operator's change, because the receiver of the Alloy
# collector has to be set to the same port by hand; the install scripts never
# write that configuration.
OTEL_PORT=4317

# Host of the OTLP/gRPC collector. A container reaches an Alloy running on the
# host through host.docker.internal, which compose.yaml makes resolvable on
# every platform; a deployment started by the run scripts reaches it on
# localhost, which the run scripts set.
OTEL_HOST=host.docker.internal

# ── Lobbies ─────────────────────────────────────────────────────────────────
# Every lobby runs as its own container that publishes its own row, so no lobby
# has to be seeded beforehand. The identity and the attributes of a gameplay
# lobby (LOBBY_NAME, LOBBY_SUBTYPE, LOBBY_PORT, LOBBY_BEGINNER_ONLY,
# LOBBY_EXPANSION_ONLY, LOBBY_NO_HEADSHOT, LOBBY_REPLAYS_ONLY) are set on its
# own service block in compose.yaml, where LOBBY_SUBTYPE is the name of a game
# type of the lobby_game_types table: FREE BATTLE, AUTOMATCHING, TOURNAMENT,
# SURVIVAL, BASIC TRAINING, COMBAT TRAINING or TOURNAMENT REGISTRATION.
# The gate and the account server
# are permanent endpoints rather than gameplay lobbies, so they are named there
# with LOBBY_NAME and LOBBY_PORT alone. Change the identity of any lobby there,
# not here, so that two lobbies cannot end up claiming the same name or port.

# ── Gameplay servers ─────────────────────────────────────────────────────────
# UDP port a GameplayServer container listens on, and the lobby it publishes
# its match in. One container per host.
GAMEPLAY_SERVER_PORT=5730
GAMEPLAY_SERVER_LOBBY_NAME=Free Battle

# Address the gameplay server announces to its peers. Defaults to ADVERTISED_ADDRESS,
# and to loopback when no advertised address is configured.
# P2P_HOST=192.168.1.50

# Account and character the gameplay server logs in with. Leave the password
# unset to have a random one generated for each process, so the account cannot
# be logged into with a known default.
# GAMEPLAY_SERVER_ACCOUNT_NAME=server
# GAMEPLAY_SERVER_ACCOUNT_PASSWORD=
# GAMEPLAY_SERVER_CHARACTER_NAME=server

# ── HTTP API ────────────────────────────────────────────────────────────────
# Port the HTTP API listens on, and the upstream launcher its patch files are
# mirrored from.
HTTP_PORT=80
LAUNCHER_SERVER=http://mgo2pc.com

# Secret used to sign and validate the API's bearer tokens. Required.
JWT_SECRET=changeme

# ── Internal coordination ───────────────────────────────────────────────────
# Port the HTTP API serves its internal gRPC endpoint on. Every gameplay lobby
# opens one persistent, bidirectional connection to it: the lobby reports the
# players that connect and disconnect, and the API pushes back the flash news
# the lobby has to write to its own clients. The MGO2 protocol is not involved
# in this path, and Discord is not either. The endpoint is internal to the
# deployment: it is never published, and no game client reaches it.
INTERNAL_GRPC_PORT=5743

# Endpoint the gameplay lobbies dial. The compose deployment reaches the HTTP
# API by its service name; the run scripts override this with localhost, which
# is where the API runs when every server is started outside containers. A
# lobby that cannot reach it keeps serving its players and tries again on an
# interval, so the HTTP API is not a dependency of a gameplay lobby.
INTERNAL_GRPC_URL=http://mgo2-http:5743

# Seconds a gameplay lobby waits before it tries the connection again. While a
# lobby is not coordinated, only the global player count and the reception of
# flash news are missing.
INTERNAL_GRPC_RECONNECT_SECONDS=60

# ── Discord ─────────────────────────────────────────────────────────────────
# Discord is an optional observer of the HTTP API and never a dependency of the
# deployment: switched off, or pointed at a Discord that is unreachable, the API
# and every lobby operate exactly as they do without it. The application, the
# bot and the roles the settings below name are described in
# docs/discord-integration.md.
DISCORD_ENABLED=false

# Bot token of the application, read from its developer portal. Required to
# publish the player count and to answer the /flash command.
# DISCORD_BOT_TOKEN=

# Identifier and Ed25519 public key of the application. The public key verifies
# the signature Discord puts on every interaction, so the endpoint answers
# nothing that does not come from Discord.
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=

# Guild the slash commands are registered in and the player count channel lives
# in.
# DISCORD_GUILD_ID=

# Channel the global player count is published in. Left unset, the channel named
# players [n] is adopted, and one is created when the guild has none.
# DISCORD_PLAYER_COUNT_CHANNEL_ID=

# Roles allowed to use the /flash command. Left unset, nobody may use it.
# DISCORD_MODERATOR_ROLE_ID=
# DISCORD_MANAGER_ROLE_ID=

# ── Name server ─────────────────────────────────────────────────────────────
# Port the name server listens on, the upstream server it forwards to, and the
# domains it answers locally. The name server binds every interface and answers
# the local domains with ADVERTISED_ADDRESS.
DNS_PORT=53
ALTERNATIVE_DNS_SERVER=8.8.8.8
ALTERNATIVE_DNS_PORT=53

# Comma-separated domains resolved to ADVERTISED_ADDRESS instead of being forwarded.
# Only exact matches are overridden; subdomains must be listed explicitly.
LOCAL_RESOLVED_DOMAINS=mgo2pc.com,game.mgo2pc.com,stun.mgo2pc.com

# Address an IPv6 address record for a local domain is answered with, so a
# resolver asking for both records is not handed the domain's upstream IPv6.
# Left unset, it is derived from ADVERTISED_ADDRESS: the wildcard :: when that is
# empty or the wildcard, or its address in IPv6-mapped form otherwise.
# ADVERTISED_ADDRESS_IPV6=::

# ── Port check (STUN) ──────────────────────────────────────────────────────
# Port the port-check responder serves. The console dials it, and the responder
# serves the port after it as well: those are the two ports of RFC 3489 section
# 8.1, and the answer to a request to change the port is sent from the second one.
# compose.yaml publishes both of them.
STUN_PORT=3478

# Address the console dials. Defaults to ADVERTISED_ADDRESS, which is the address
# the name server resolves the local domains to; set it to override that for this
# responder alone.
# STUN_PRIMARY_ADDRESS=192.168.1.50

# Second address of this machine. The console asks the responder to answer from a
# different address and reads whether that answer arrives, which is how it decides
# it is behind a full-cone NAT and safe to accept direct connections from peers.
# With one address the responder can only move the port, and every restricted-cone
# player is then told they are a full-cone peer they cannot play as, so give this
# a second address the machine owns:
#
#   ip addr add 192.168.1.51/24 dev eth0
#
# It does not survive a reboot, and it only works where the responder owns host
# addresses: the mgo2-stun container of compose.yaml is on the bridge network and
# clears this setting, because a container has one address and answering from a
# second one is not something it can do. Serve the responder with
# network_mode: host, or from scripts/run-linux-macos.sh or run-windows.ps1
# outside Docker, to use it. Both ports and both addresses must then be free to
# bind.
# STUN_SECONDARY_ADDRESS=192.168.1.51

# ── Lobby lifecycle ─────────────────────────────────────────────────────────
# Interval in minutes between two heartbeats and two lobby cache refreshes. A
# gameplay lobby, and a match owned by a gameplay server, is served only while it
# was written to within twice this interval, after which it is cleaned up.
LOBBIES_REFRESH_INTERVAL_MINUTES=5
