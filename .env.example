# PostgreSQL connection string
# When left unset the bundled PostgreSQL instance is used automatically.
# DATABASE_URL=postgresql://postgres@localhost/mgo2

# IP address the server binds to; also the address returned by the DNS server
# for locally overridden domains
# Default: 0.0.0.0
LISTENING_IP=0.0.0.0

# DNS
# Set to true to prevent the DNS server from starting
# Default: false
DISABLE_DNS_SERVER=false

# Upstream DNS server used to forward queries that are not locally overridden
# Default: 8.8.8.8
ALTERNATIVE_DNS_SERVER=8.8.8.8

# Port used when forwarding DNS queries to the alternative DNS server
# Default: 53
ALTERNATIVE_DNS_PORT=53

# Comma-separated list of domains that the DNS server resolves to LISTENING_IP
# instead of forwarding upstream. Only exact matches are overridden — subdomains
# are NOT implicitly included and must be listed explicitly if needed.
# Default: mgo2pc.com,game.mgo2pc.com
LOCAL_RESOLVED_DOMAINS=mgo2pc.com,game.mgo2pc.com

# Unique identifier for this server instance, used to track per-instance player
# counts in the lobby_instance_counts table for horizontal scaling. Defaults to
# a random UUID if not set.
# INSTANCE_ID=server-01

# Cron expression controlling how often the in-memory lobby cache is refreshed
# from the database
# Default: every 15 minutes
LOBBIES_REFRESH_CRON=*/15 * * * *

# HyperDX API key for OpenTelemetry-based observability (optional)
# When omitted, telemetry is disabled
# HDX_API_KEY=

# OpenTelemetry Collector endpoint for exporting telemetry data (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://raspberrypi.local:4318