appsettings.json
bin/
obj/

# Written by `dotnet affected` when the pipelines run it locally.
affected.json
affected.proj
affected.txt

# Python bytecode left behind by the analysis scripts in tools/.
__pycache__/

# The local compose stack's TLS pair; see certs/README.md. A private key never
# belongs in git, and the deployment's copy lives in a Kubernetes Secret.
certs/*
!certs/README.md

# Game binaries
.game/

# Game tools
.gametools/

# Packet captures
.pcapngs/

# Session output: decoded record dumps, emulator minidumps and one-off scripts
# written while reading a capture. The findings belong in docs/analysis/.
_scratch/
tmpout/
*.dmp
